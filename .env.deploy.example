## Local deploy config — copy to `.env.deploy` and fill in (never commit `.env.deploy`).
##
## Usage:
##   npm run deploy          # build + SFTP upload to DreamHost
##   npm run deploy:sync     # upload only (dist must exist)
##   npm run deploy:dry-run  # preview upload/delete without changing server

# DreamHost SSH hostname from panel → Users → Manage Users (e.g. ps123456.dreamhost.com)
DEPLOY_HOST=ps123456.dreamhost.com

# DreamHost shell user (must match /home/USERNAME/ in DEPLOY_PATH)
DEPLOY_USER=your_dreamhost_user

# Remote document root (trailing slash optional; script normalizes)
DEPLOY_PATH=/home/your_dreamhost_user/www.camelbird.com

# SSH port (DreamHost default)
DEPLOY_PORT=22

# Private key authorized on the server (~/.ssh/authorized_keys)
DEPLOY_SSH_KEY=C:/Users/Daniel/.ssh/dreamhost_ed25519

# Optional: passphrase for an encrypted private key
# DEPLOY_SSH_KEY_PASSPHRASE=
